										"Events": [],
										"Text": {
											"$text": "# PATROL ROSTER – WEEK 44 (ARCHIVED)\r\n\r\nCheckpoint Alpha .... Squad Kestrel (day) / Squad Heron (night)\r\nCheckpoint Bravo .... Squad Marten (day) / understrength (night)\r\nRail Yard sweep ..... Squad Kestrel, 10:00 daily\r\nWater Plant ......... Engineering detachment, escort on request\r\n\r\n> Squad Heron was reassigned to the Quarry on 29/10. Night shift at Alpha has run short since."
										}
									}
								]
							}
						}
					},
					{
						"$class": "/Script/IRRMissionSystem.IRRTerminalFile",
						"Name": "Evacuation_Notice.txt",
						"bAutoHack": false,
						"Responses": {
							"Mission.Terminal.Commands.Read": {
								"Condition": [],
								"Sequences": [
									{
										"$class": "/Game/Blueprints/MissionSystem/Objects/Terminal/Sequences/BP_TerminalSequence_Text.BP_TerminalSequence_Text_C",
										"Widget": "/Game/Blueprints/MissionSystem/UI/Terminal/Response/W_TerminalResponse_Text.W_TerminalResponse_Text_C",
										"Events": [],
										"Text": {
											"$text": "# CIVIL NOTICE – EVACUATION ROUTES (ARCHIVED)\r\n\r\nResidents east of the ring road may leave the city through Checkpoint Alpha between 06:00 and 18:00 with a valid ration card.\r\n\r\nRoutes via the rail yard and the water treatment plant are CLOSED.\r\n\r\nThis notice was withdrawn on 01/11. Civilian departures are suspended until further notice."
										}
									}
								]
							}
						}
					}
				]
			}
		],
		"Commands": [
			{
				"Keyword": "help",
