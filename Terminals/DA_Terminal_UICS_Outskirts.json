										"Events": [],
										"Text":
										{
											"$text": "# WELCOME TO OUTSKIRTS (2011 investor brochure, archived)\r\n\r\nDear guest,\r\n\r\nWelcome to the Outskirts Communications & Conference Complex. You are standing at the gateway to the region's future.\r\n\r\n- A deep-water port, ready for trade\r\n- A brand-new resort on the north shore, opening next season\r\n- An airstrip with direct connections\r\n- Coastal apartments for a growing workforce, and a processing plant under way\r\n\r\nInvest in Outskirts today, and help bring stability and prosperity to the whole region.\r\n\r\n> Handwritten in the margin: \"The vacationers never came. The VLF did.\"",
											"$ns": "[2C9853E6E633F3D3F51C087FCE244600]",
											"$key": "2C534AE145292E834DF170A763CF1FE5"
										}
